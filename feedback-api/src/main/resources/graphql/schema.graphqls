## GraphQL schema for Feedback API.
##
## This schema maps the existing REST endpoints to GraphQL:
## - Query.getFeedback(memberId)       -> GET /api/v1/feedback?memberId=...
## - Query.getFeedbackById(id)        -> GET /api/v1/feedback/{id}
## - Mutation.createFeedback(input)   -> POST /api/v1/feedback

"Represents a feedback entry returned to clients."
type Feedback {
  id: ID!
  memberId: String!
  providerName: String!
  rating: Int!
  comment: String
  submittedAt: String
}

"Input used to create new feedback (maps to FeedbackRequest DTO)."
input FeedbackInput {
  memberId: String!
  providerName: String!
  rating: Int!
  comment: String
}

type Query {
  "Retrieve feedback entries; optional memberId filters results (newest first)"
  getFeedback(memberId: String): [Feedback!]!

  "Retrieve a single feedback entry by ID"
  getFeedbackById(id: ID!): Feedback
}

type Mutation {
  "Create new feedback; returns the created Feedback"
  createFeedback(input: FeedbackInput!): Feedback!
}
